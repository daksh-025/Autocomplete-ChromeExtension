{
  "manifest_version": 3,
  "name": "Universal Autocomplete Assistant",
  "version": "1.0.0",
  "description": "Provides autocomplete suggestions while you type anywhere on the web. Press Tab or click a suggestion to insert.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Universal Autocomplete Assistant"
  }
}